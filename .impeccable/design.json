  "narrative": {
    "northStar": "The Living Pottery Archive",
    "overview": "A living archive brings the object, its maker, and its making into view together. vCraft feels unhurried, tactile, and grounded in people. Rice-paper surfaces, literary headings, and natural-light pottery imagery carry the approved warm editorial world; dependable navigation and controls frame the objects.\n\nThe first implementation follows the user-selected wide exhibition composition B: an introductory band, panoramic still life, and three curated sample pieces. The present content is explicitly illustrative. Maker stories and provenance remain future content requiring evidence; PRODUCT.md governs product facts.",
    "keyCharacteristics": [
      "Measured and mindful: “Từ tốn” guides visual pacing without delaying interaction.",
      "Material warmth: rice paper, cobalt glaze, fired clay, and wood ash.",
      "Literary clarity: Lora headings and Be Vietnam Pro interface text.",
      "Honest evidence: illustrative pieces are labelled and missing provenance stays explicit.",
      "Editorial breathing room: spacious imagery with coherent source and mobile reading order."
    ],
    "rules": [
      {
        "name": "The Material Evidence Rule",
        "body": "Let pottery imagery express material character; keep typography, alignment, navigation, and controls dependable.",
        "section": "overview"
      },
      {
        "name": "The Glaze and Ground Rule",
        "body": "Let paper surfaces and pottery imagery dominate; use cobalt to establish action hierarchy and clay for restrained warm details.",
        "section": "colors"
      },
      {
        "name": "The Complete Voice Rule",
        "body": "Preserve Vietnamese accents and full names; allow headings and body copy to wrap without clipping diacritics.",
        "section": "typography"
      },
      {
        "name": "The Reading Order Rule",
        "body": "Preserve logical source order, keyboard order, and narrow-screen flow when extending editorial layouts.",
        "section": "layout"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Keep exhibition cards flat; do not add card lift, hard shadows, glass, gradients, or glow to this world.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve rice-paper grounds, cobalt actions, clay hairlines, and the Lora/Be Vietnam Pro pairing.",
      "Do label illustrative imagery and sample pieces; keep missing stories and provenance explicit.",
      "Do preserve Vietnamese diacritics, visible focus, usable targets, and reduced-motion behavior.",
      "Do retain complete product silhouettes with contained gallery imagery.",
      "Do keep object, maker, and provenance meaningfully connected when authentic records become available."
    ],
    "donts": [
      "Don't invent maker biographies, quotations, prices, certifications, origin, or cooking-safety claims.",
      "Don't turn static sample figures into apparent product links without real destinations.",
      "Don't add nested card shells, floating product shadows, fluorescent accents, or decorative heritage motifs.",
      "Don't hide essential information behind hover or add motion that withholds initial content.",
      "Don't treat this as-built record or development screenshots as a completed comp review receipt."
    ]
  }
}
