{
  "name": "vcraft",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-db.mjs",
    "db:import-sqlite": "node --env-file-if-exists=.env scripts/import-sqlite.mjs",
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "leaflet": "^1.9.4",
    "motion": "^14.14.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-plugin": "1.168.48",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
